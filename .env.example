# Copy to .env and export it before running the persistence command.
# This example uses local Unix socket authentication and your macOS user.
DATABASE_URL=postgresql:///urbanflow_ai
# Integration tests require a separate disposable database.
# TEST_DATABASE_URL=postgresql:///urbanflow_ai_test

# Dashboard defaults to the versioned offline snapshot; never falls back silently.
# URBANFLOW_DATA_BACKEND=snapshot
# URBANFLOW_SNAPSHOT_DIR=/absolute/path/to/a/versioned/dashboard/bundle
# Set URBANFLOW_DATA_BACKEND=postgres for explicit local read-only database access.
